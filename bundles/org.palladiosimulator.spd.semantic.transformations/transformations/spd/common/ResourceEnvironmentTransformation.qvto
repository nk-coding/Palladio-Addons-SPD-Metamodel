library ResourceEnvironmentTransformation;

modeltype SPD_MOD uses 'http://palladiosimulator.org/ScalingPolicyDefinition/1.0';
modeltype SPD_ADJ uses 'http://palladiosimulator.org/ScalingPolicyDefinition/Adjustments/1.0';
modeltype SPD_TRI uses 'http://palladiosimulator.org/ScalingPolicyDefinition/Triggers/1.0';
modeltype SPD_TAR uses 'http://palladiosimulator.org/ScalingPolicyDefinition/Targets/1.0';
modeltype PCM_RES_ENV uses 'http://palladiosimulator.org/PalladioComponentModel/ResourceEnvironment/5.2';
modeltype SPD_SEM uses 'http://palladiosimulator.org/ScalingPolicyDefinitionSemantic/1.0';


/**
* The containers of the environment: the elements of the elastic infrastructure, then the other
* containers.
*/
mapping inout ResourceEnvironment::modifyResourceEnvironment(elasticInfrastructureCfg:ElasticInfrastructureCfg, invariantResourceContainers:OrderedSet(ResourceContainer)){
	init { 
		var completeSetOfResourceContainers:OrderedSet(ResourceContainer) := elasticInfrastructureCfg.elements->asOrderedSet();
		invariantResourceContainers->forEach(rc){
			if(completeSetOfResourceContainers->excludes(rc)){
				completeSetOfResourceContainers := completeSetOfResourceContainers->append(rc);
			};
		};
	}
	resourceContainer_ResourceEnvironment := completeSetOfResourceContainers;
	linkingResources__ResourceEnvironment.map modifyLinkingResource(completeSetOfResourceContainers, elasticInfrastructureCfg);
}

/**
* A link keeps its containers that are still in the environment; a link the unit is connected to
* also connects the new elements of the elastic infrastructure. Links the unit is not on keep their
* containers. (Before, every link was connected to every container of the environment.)
*/
mapping inout LinkingResource::modifyLinkingResource(resourceContainers:OrderedSet(ResourceContainer), elasticInfrastructureCfg:ElasticInfrastructureCfg){
	init {
		var connected:OrderedSet(ResourceContainer) := self.connectedResourceContainers_LinkingResource->select(rc | resourceContainers->includes(rc))->asOrderedSet();
		if(connected->includes(elasticInfrastructureCfg.unit)){
			elasticInfrastructureCfg.elements->forEach(rc){
				if(connected->excludes(rc)){
					connected := connected->append(rc);
				};
			};
		};
	}
	connectedResourceContainers_LinkingResource := connected;
}
